
/* pages/login/login.wxss - 微信风格 */

/* 页面容器 */
.login-page {
  min-height: 100vh;
  background-color: #ededed;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx;
  box-sizing: border-box;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
  margin-top: 80rpx;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  background-color: #07c160;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo-symbol {
  font-size: 80rpx;
  color: #ffffff;
  font-weight: 700;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #000000;
}

/* 表单区域 */
.form-section {
  width: 100%;
  max-width: 600rpx;
}

.input-group {
  position: relative;
  margin-bottom: 2rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e5e5e5;
}

.input-group:first-child {
  border-radius: 8rpx 8rpx 0 0;
}

.input-group:nth-child(3) {
  border-radius: 0 0 8rpx 8rpx;
  border-bottom: none;
}

.input {
  width: 100%;
  height: 100rpx;
  padding: 0 30rpx;
  padding-right: 120rpx;
  font-size: 32rpx;
  color: #000000;
  background-color: transparent;
  box-sizing: border-box;
}

.input-placeholder {
  color: #b2b2b2;
}

/* 密码显示切换 */
.password-toggle {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 20rpx;
}

.toggle-text {
  font-size: 28rpx;
  color: #576b95;
}

/* 错误提示 */
.error-message {
  margin-top: 30rpx;
  text-align: center;
}

.error-text {
  font-size: 28rpx;
  color: #fa5151;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  margin-top: 60rpx;
  background-color: #07c160;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 500;
  border-radius: 8rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background-color: #9ed29e;
  color: rgba(255, 255, 255, 0.6);
}

/* 底部提示 */
.footer-tips {
  margin-top: auto;
  padding-bottom: 60rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #999999;
}
