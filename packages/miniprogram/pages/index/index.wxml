<!-- pages/index/index.wxml - 专业风格会话列表 -->
<view class="index-page">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <text class="nav-title">OpenCode</text>
    <view class="nav-actions">
      <view class="nav-btn" bindtap="handleSearch">
        <text class="nav-icon search">🔍</text>
      </view>
      <view class="nav-btn primary" bindtap="handleNewSession">
        <text class="nav-icon">➕</text>
      </view>
    </view>
  </view>

  <!-- 项目选择器区域 -->
  <view class="project-section" wx:if="{{projects.length > 0}}">
    <view class="project-header">
      <text class="section-title">当前项目</text>
    </view>
    <view class="project-card">
      <picker 
        mode="selector" 
        range="{{projects}}" 
        range-key="displayName"
        value="{{selectedProjectIndex}}"
        bindchange="onProjectChange"
      >
        <view class="project-selector">
          <view class="project-info">
            <view class="project-icon">
              <text class="icon-text">📁</text>
            </view>
            <view class="project-details">
              <text class="project-name">{{selectedProject.displayName}}</text>
              <text class="project-path">{{selectedProject.worktree}}</text>
            </view>
          </view>
          <view class="selector-action">
            <text class="action-text">切换</text>
            <text class="arrow">›</text>
          </view>
        </view>
      </picker>
      
      <!-- 新建会话按钮 -->
      <view class="new-session-btn" bindtap="handleNewSession">
        <text class="btn-icon">✏️</text>
        <text class="btn-text">新建会话</text>
        <text class="btn-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view wx:if="{{showSearch}}" class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索会话..." 
        value="{{searchQuery}}"
        bindinput="onSearchInput"
        focus="{{showSearch}}"
      />
      <view wx:if="{{searchQuery}}" class="clear-btn" bindtap="clearSearch">
        <text class="clear-icon">✕</text>
      </view>
    </view>
    <text class="search-cancel" bindtap="closeSearch">取消</text>
  </view>

  <!-- 会话列表标题 -->
  <view class="list-header" wx:if="{{!showSearch}}">
    <text class="list-title">历史会话</text>
    <text class="list-count" wx:if="{{filteredSessions.length > 0}}">{{filteredSessions.length}} 个会话</text>
  </view>

  <!-- 会话列表 -->
  <scroll-view 
    class="session-list" 
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{loading}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <!-- 加载中 -->
    <view wx:if="{{loading && sessions.length === 0}}" class="loading-state">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 会话项 -->
    <view 
      class="session-item" 
      wx:for="{{filteredSessions}}" 
      wx:key="id"
      bindtap="handleSessionTap"
      data-id="{{item.id}}"
    >
      <!-- 头像 -->
      <view class="session-avatar">
        <text class="avatar-text">💬</text>
      </view>

      <!-- 内容区 -->
      <view class="session-content">
        <view class="session-header">
          <text class="session-title">{{item.title}}</text>
          <text class="session-time">{{item.time}}</text>
        </view>
        <view class="session-meta">
          <text class="session-preview" wx:if="{{item.preview}}">{{item.preview}}</text>
          <text class="session-preview empty" wx:else>点击继续对话</text>
        </view>
        <view class="session-tags" wx:if="{{item.model}}">
          <text class="tag">{{item.model}}</text>
        </view>
      </view>

      <!-- 滑动操作区 -->
      <view class="session-actions">
        <view 
          class="action-btn delete" 
          catchtap="handleDelete"
          data-id="{{item.id}}"
        >
          <text class="action-icon">🗑️</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!loading && filteredSessions.length === 0}}" class="empty-state">
      <view class="empty-icon-wrapper">
        <text class="empty-icon">💭</text>
      </view>
      <text class="empty-title">暂无会话</text>
      <text class="empty-desc">点击上方"新建会话"开始与AI对话</text>
      <view class="empty-action" bindtap="handleNewSession">
        <text class="action-text">立即开始</text>
      </view>
    </view>

    <!-- 底部间距 -->
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
