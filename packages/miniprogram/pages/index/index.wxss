
/* pages/index/index.wxss - 微信风格 */

.index-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ededed;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  height: 88rpx;
  background-color: #ededed;
  border-bottom: 1rpx solid #d9d9d9;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #000000;
}

.nav-actions {
  display: flex;
  gap: 30rpx;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  font-size: 36rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #ededed;
  border-bottom: 1rpx solid #e5e5e5;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #b2b2b2;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #000000;
}

.search-cancel {
  margin-left: 30rpx;
  font-size: 30rpx;
  color: #576b95;
}

/* 会话列表 */
.session-list {
  flex: 1;
  background-color: #ffffff;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

/* 会话项 */
.session-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #e5e5e5;
  position: relative;
}

.session-item:active {
  background-color: #e6e6e6;
}

/* 头像 */
.session-avatar {
  width: 96rpx;
  height: 96rpx;
  background-color: #07c160;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
}

/* 内容区 */
.session-content {
  flex: 1;
  min-width: 0;
  padding-right: 100rpx;
}

.session-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.session-title {
  font-size: 32rpx;
  color: #000000;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-time {
  font-size: 24rpx;
  color: #b2b2b2;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.session-preview {
  font-size: 28rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 16rpx 24rpx;
  background-color: #fa5151;
  border-radius: 8rpx;
}

.delete-icon {
  font-size: 26rpx;
  color: #ffffff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 28rpx;
  color: #576b95;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 100rpx;
  background-color: #f7f7f7;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
}

.tab-item.active .tab-text {
  color: #07c160;
}
